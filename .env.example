# ORIENTAI local server-side model configuration (copy to .env.local; never commit actual secrets)
#
# Generate your personal key at https://llm.arc.vt.edu
# User profile > Settings > Account > API keys
#
# The ARC endpoint is https://llm-api.arc.vt.edu/api/v1/chat/completions
# Keep ARC_API_KEY private. Do NOT prefix it with NEXT_PUBLIC_.
#
# Only enable ARC on your private, authorized development deployment.
# Shared/team/public usage with an individual's personal ARC key requires
# explicit authorization from ARC; never treat a stored secret as permission
# to share a VT account's quota or upload controlled Boeing data.
AI_COPILOT_ENABLED=false
ARC_API_KEY=
ARC_API_BASE_URL=https://llm-api.arc.vt.edu/api/v1
ARC_MODEL=gpt-oss-120b

# Optional existing alternate Vercel AI Gateway provider.
# When ARC_API_KEY is set, ARC takes precedence.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=
